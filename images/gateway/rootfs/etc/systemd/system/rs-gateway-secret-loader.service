[Unit]
Description=RS Gateway fail-closed runtime secret loader
After=cloud-final.service network-online.target
Before=rs-gateway-wireguard@wg-users.service
Before=rs-gateway-wireguard@wg-personal.service
Before=rs-gateway-wireguard@wg-nodes.service
Before=rs-gateway-nftables.service rs-gateway-adguard.service

[Service]
Type=oneshot
EnvironmentFile=/etc/rs-gateway/runtime.env
ExecStart=/usr/lib/rs-gateway/secret_loader.py
RemainAfterExit=yes
RuntimeDirectory=rs-gateway
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/rs-gateway

[Install]
WantedBy=rs-gateway.target
