[Unit]
Description=RS Gateway default-drop nftables policy
Requires=rs-gateway-secret-loader.service
Requires=rs-gateway-wireguard@wg-users.service
Requires=rs-gateway-wireguard@wg-personal.service
Requires=rs-gateway-wireguard@wg-nodes.service
After=rs-gateway-secret-loader.service
After=rs-gateway-wireguard@wg-users.service
After=rs-gateway-wireguard@wg-personal.service
After=rs-gateway-wireguard@wg-nodes.service
Before=rs-gateway-reconcile.service rs-gateway-adguard.service

[Service]
Type=oneshot
EnvironmentFile=/etc/rs-gateway/runtime.env
ExecStartPre=/usr/lib/rs-gateway/render_nftables.py
ExecStart=/usr/sbin/nft -f /run/rs-gateway/nftables.conf
ExecReload=/usr/lib/rs-gateway/render_nftables.py
ExecReload=/usr/sbin/nft -f /run/rs-gateway/nftables.conf
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=rs-gateway.target
