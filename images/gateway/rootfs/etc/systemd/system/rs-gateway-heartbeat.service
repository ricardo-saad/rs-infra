[Unit]
Description=Publish RS Gateway value-free heartbeat
Requires=rs-gateway-secret-loader.service rs-gateway-restore.service
Requires=rs-gateway-adguard.service
After=rs-gateway-secret-loader.service rs-gateway-restore.service
After=rs-gateway-adguard.service network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/rs-gateway/runtime.env
ExecStart=/usr/lib/rs-gateway/publish-heartbeat.py
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadOnlyPaths=/run/rs-gateway/loaded-versions.json
