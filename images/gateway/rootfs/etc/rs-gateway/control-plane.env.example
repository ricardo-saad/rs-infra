# Non-secret transport identifiers. The client private key is referenced by
# path and is never placed in this file. Provisioning and renewal of the
# short-lived mTLS identity are intentionally outside this image contract.
CONTROL_PLANE_GATEWAY_ID=replace-with-opaque-gateway-id
CONTROL_PLANE_DESIRED_URL=https://console.example.invalid/configured-desired-endpoint
CONTROL_PLANE_ACK_URL=https://console.example.invalid/configured-ack-endpoint
CONTROL_PLANE_CA_FILE=/run/rs-gateway/control-plane/server-ca.pem
CONTROL_PLANE_CLIENT_CERT_FILE=/run/rs-gateway/control-plane/client-cert.pem
CONTROL_PLANE_CLIENT_KEY_FILE=/run/rs-gateway/control-plane/client-key.pem
CONTROL_PLANE_POLL_SECONDS=15
