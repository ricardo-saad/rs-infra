{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rs-platform.invalid/gateway/peer-delivery-v1.json",
  "title": "RS Gateway console-owned peer manifest delivery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "gateway_id",
    "delivery_id",
    "manifest_digest",
    "manifest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "gateway_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "delivery_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "manifest": {
      "allOf": [
        {
          "$ref": "peer-manifest.schema.json"
        },
        {
          "type": "object",
          "properties": {
            "interface": {
              "enum": [
                "wg-users",
                "wg-nodes"
              ]
            }
          }
        }
      ]
    }
  }
}
