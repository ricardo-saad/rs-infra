{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rs-platform.invalid/gateway/peer-manifest-v1.json",
  "title": "RS Gateway complete per-interface peer manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "interface",
    "generation",
    "generated_at",
    "peers"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "interface": {
      "enum": [
        "wg-users",
        "wg-personal",
        "wg-nodes"
      ]
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "peers": {
      "type": "array",
      "maxItems": 253,
      "items": {
        "$ref": "#/$defs/peer"
      }
    }
  },
  "$defs": {
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "peer_id",
        "public_key",
        "address",
        "health_policy"
      ],
      "properties": {
        "peer_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "public_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9+/]{43}=$"
        },
        "address": {
          "type": "string",
          "pattern": "^10\\.100\\.(0|2|3)\\.[0-9]{1,3}/32$"
        },
        "health_policy": {
          "enum": [
            "required",
            "on_demand"
          ]
        },
        "permissions": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "enum": [
              "egress",
              "games"
            ]
          },
          "contains": {
            "const": "egress"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "address": {
                "pattern": "^10\\.100\\.0\\."
              }
            },
            "required": [
              "address"
            ]
          },
          "then": {
            "required": [
              "permissions"
            ]
          },
          "else": {
            "not": {
              "required": [
                "permissions"
              ]
            }
          }
        }
      ]
    }
  }
}
