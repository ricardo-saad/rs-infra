{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.rs-platform.invalid/gateway/game-target-v1.json",
  "title": "RS Gateway reviewed game target",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "destination",
    "protocol",
    "port"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "destination": {
      "type": "string",
      "pattern": "^(?:[0-9]{1,3}\\.){3}[0-9]{1,3}/32$"
    },
    "protocol": {
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  }
}
